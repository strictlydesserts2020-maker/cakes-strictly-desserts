# ============================================================
#  Supabase — copy to .env.local and fill with your values
#  (Project Settings -> API in the Supabase dashboard)
# ============================================================

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only (NEVER prefix with NEXT_PUBLIC_, never commit).
# Used only inside API routes / server actions for privileged writes
# such as receiving public enquiries. Optional if you rely purely on RLS.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Business config
NEXT_PUBLIC_WHATSAPP_NUMBER=919003082979
